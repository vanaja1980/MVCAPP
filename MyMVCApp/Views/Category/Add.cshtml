@using MyMVCApp.Model
@model Category
                    
@section styles {
    <div> Edit Categories</div>
}
<form method="post" asp-controller="category" asp-action="Add">
    <div class="row mb-3">
        <label asp-for="id" class="col-sm-2 col-form-label">Id</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" asp-for="id" id="inputEmail3">
        </div>
    </div>
    <div class="row mb-3">
        <label asp-for="name" class="col-sm-2 col-form-label">Name</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" asp-for="name" id="inputEmail3">
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Sign in</button>
</form>