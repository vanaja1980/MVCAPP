@model List<Category>;
@{
	Layout = "_Layout";
}
@section styles {
    <div> Categories</div>
}
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Description</th>

        </tr>
    </thead>
	@foreach(var item in Model)
	{
            <tbody>
                <tr>
                <td> 
                   @*  <a href="/category/Edit?Id=@item.id">@item.id</a> *@
                    <a class="btn btn-link" asp-controller="Category" asp-action="Edit" asp-route-id="@item.id">@item.id</a>
                    </td>
                    <td>@item.name</td>
                <td>@item.description</td>
                </tr>
            </tbody>
        
	}
    </table>
<a class="btn btn-primary" asp-controller="Category" asp-action="Add">Add</a>
