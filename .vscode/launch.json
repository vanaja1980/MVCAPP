{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Launch MyMVCApp",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/MyMVCApp/bin/Debug/net10.0/MyMVCApp.dll",
            "args": [],
            "cwd": "${workspaceFolder}/MyMVCApp",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5224"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}
